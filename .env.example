# ==========================================
# ApexRPC-Zero Configuration
# ==========================================

# Your server region to display on Discord (e.g., Singapore, Taiwan, Tokyo, Oregon, Frankfurt)
PLAYING_ON_SERVER=Singapore

# Preferred mode to track the map rotation for:
# Options: ranked, pubs, mixtape
DEFAULT_MODE=ranked

# Apex Legends Status (ALS) API Key for automatic map rotation
# Get a free key instantly at: https://apexlegendsapi.com/
# (If left blank, it will show the FALLBACK_MAP below)
ALS_API_KEY=

# Fallback map name if no API key is provided or offline
FALLBACK_MAP=World's Edge

# How often to check if Apex Legends is running (milliseconds)
PROCESS_POLL_INTERVAL_MS=5000

# How often to refresh map rotation from API (milliseconds)
MAP_POLL_INTERVAL_MS=120000

# Discord Application Client ID (Leave blank to use default ApexRPC ID)
DISCORD_CLIENT_ID=893911040713191444
