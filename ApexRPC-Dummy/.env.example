# ==========================================
# ApexRPC-Dummy Configuration
# ==========================================

# Dummy Steam Account credentials (ไอดีไก่ บัญชีสำรอง)
# (สร้างบัญชี Steam เปล่าๆ ไว้ดักฟัง เพื่อไม่ให้กระทบบัญชีหลัก)
DUMMY_STEAM_USERNAME=
DUMMY_STEAM_PASSWORD=

# SteamID64 ของบัญชีหลักที่คุณใช้เล่นเกมจริง
# (ดูได้ที่ https://steamid.io เช่น 76561198xxxxxxxx)
# **ข้อสำคัญ:** ต้องแอดเป็นเพื่อนกันกับไอดีไก่ด้วยนะครับ
MAIN_STEAM_ID64=

# Server region to display on Discord (e.g. Singapore, Taiwan, Tokyo)
PLAYING_ON_SERVER=Singapore

# Auto detect server from Steam Rich Presence if available (true / false)
AUTO_DETECT_SERVER=true

# Discord Client ID (Leave blank to use default ApexRPC ID)
DISCORD_CLIENT_ID=
